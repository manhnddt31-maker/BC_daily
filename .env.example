# Chỉ cấu hình trong secret manager hoặc .env.local; không commit giá trị thật.
BACKEND_API_URL=http://localhost:8000
BACKEND_SERVICE_TOKEN=CHANGE_ME_TO_THE_SAME_VALUE_AS_FASTAPI

# Vercel đọc snapshot công khai từ Supabase; không đặt secret key ở đây.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Chỉ giữ trong cửa sổ rollback trước khi xóa luồng Google cũ.
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
